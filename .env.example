# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CTF Security Secrets (Configured server-side)
# ADMIN_USER_ID: Cryptographically randomized, high-entropy admin identifier (e.g. sys_ctrl_9f8a2b1e7c_root)
ADMIN_USER_ID="sys_ctrl_9f8a2b1e7c_root"

# ADMIN_USERNAME: Master admin operator display name (e.g. "Rabum Alal")
ADMIN_USERNAME="Rabum Alal"

# ADMIN_PASSWORD: Master password for admin arbitration access
ADMIN_PASSWORD="CyberZero#2026!"

# ADMIN_EMAIL: Organizer email for seamless stealth admin login
ADMIN_EMAIL="admin@finaldecrypt.ctf"

# ADMIN_ROUTE_SECRET: Stealth high-entropy route for organizers to access admin auth
ADMIN_ROUTE_SECRET="/portal-auth-ctrl-8f9b2"

# SESSION_SECRET: Cryptographic secret for signing JWT / HMAC session tokens
SESSION_SECRET="MY_RANDOM_HMAC_SESSION_SECRET"

# REDIS_URL: Optional Redis instance for multi-instance load balancing & rate-limiting
# REDIS_URL="redis://localhost:6379"
